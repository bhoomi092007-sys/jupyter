from IPython.display import HTML, display

html_code = r"""
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>AI Action Item Extractor</title>

<style>
* {
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #eef2ff, #fce7f3);
    padding: 25px;
    color: #333;
}

.container {
    max-width: 900px;
    margin: auto;
}

header {
    text-align: center;
    margin-bottom: 25px;
}

header h1 {
    color: #5b21b6;
}

.card {
    background: white;
    padding: 25px;
    border-radius: 18px;
    margin-bottom: 20px;
    box-shadow: 0 5px 20px #00000012;
}

textarea {
    width: 100%;
    height: 220px;
    padding: 15px;
    border: 2px solid #ddd6fe;
    border-radius: 12px;
    font-size: 15px;
    resize: vertical;
}

button {
    padding: 12px 18px;
    border: none;
    border-radius: 9px;
    margin: 8px 5px 0 0;
    cursor: pointer;
    font-weight: bold;
}

.primary {
    background: #6d28d9;
    color: white;
}

.secondary {
    background: #2563eb;
    color: white;
}

.green {
    background: #059669;
    color: white;
}

.gray {
    background: #e5e7eb;
    color: #333;
}

.result {
    background: #f5f3ff;
    border-left: 5px solid #8b5cf6;
    padding: 18px;
    border-radius: 10px;
    margin: 12px 0;
}

.result h3 {
    color: #6d28d9;
}

.message {
    margin-top: 15px;
    font-weight: bold;
}

footer {
    text-align: center;
    color: #777;
    margin-top: 25px;
}
</style>
</head>

<body>

<div class="container">

<header>
    <h1>🤖 AI Action Item Extractor</h1>
    <p>Convert meeting notes into organized action items</p>
</header>

<div class="card">

    <h2>📝 Meeting Notes</h2>

    <textarea id="notes" placeholder="Enter your meeting notes here..."></textarea>

    <br>

    <button class="gray" onclick="loadSample()">
        Load Sample Notes
    </button>

    <br><br>

    <button class="primary" onclick="extractActions()">
        Extract Action Items
    </button>

    <button class="green" onclick="copyResults()">
        Copy Results
    </button>

    <button class="secondary" onclick="downloadResults()">
        Download JSON
    </button>

    <button class="gray" onclick="clearAll()">
        Clear
    </button>

    <div id="message" class="message"></div>

</div>

<div class="card">

    <h2>📋 Extracted Action Items</h2>

    <h3 id="count">0 Actions</h3>

    <div id="results">
        <p>Your action items will appear here.</p>
    </div>

</div>

<footer>
    AI Action Item Extractor | Smart Meeting Assistant
</footer>

</div>

<script>

const sampleNotes = `Website revamp kickoff
Alex: What are the main features you want on the new landing page?
Client: We need a modern hero section, customer testimonials, and an integrated booking calendar.
Alex: Would you prefer Calendly integration or a custom-built solution?
Client: Calendly works fine and keeps it simple.
Alex: Perfect, I'll prepare the initial wireframes by Wednesday.`;

let actions = [];

function loadSample() {
    document.getElementById("notes").value = sampleNotes;
}

function extractActions() {

    const notes = document.getElementById("notes").value.trim();

    if (!notes) {
        showMessage("Please enter meeting notes.", "red");
        return;
    }

    actions = [];

    const lines = notes.split("\n");

    lines.forEach(line => {

        line = line.trim();

        const match = line.match(
            /^([^:\n]+):\s*(.+?)\s+by\s+([^\n.]+)[.]?$/i
        );

        if (match) {

            actions.push({
                owner: match[1].trim(),
                task: match[2].trim(),
                deadline: match[3].trim()
            });

        }

    });

    // Additional offline extraction for the sample meeting notes
    if (actions.length === 0) {

        lines.forEach(line => {

            const match = line.match(
                /^([^:\n]+):\s*(.+)$/ 
            );

            if (match && /I'll|I will|need to|should|must|will prepare|will create|will complete/i.test(match[2])) {

                let task = match[2].trim();

                let deadline = "Not specified";

                const deadlineMatch = task.match(
                    /\bby\s+(Wednesday|Thursday|Friday|Monday|Tuesday|tomorrow|today|next week)\b/i
                );

                if (deadlineMatch) {
                    deadline = deadlineMatch[1];
                    task = task.replace(deadlineMatch[0], "").trim();
                }

                actions.push({
                    owner: match[1].trim(),
                    task: task,
                    deadline: deadline
                });

            }

        });

    }

    displayResults();

    showMessage(
        actions.length + " action item(s) extracted offline.",
        "green"
    );
}

function displayResults() {

    const results = document.getElementById("results");

    document.getElementById("count").textContent =
        actions.length + " Actions";

    results.innerHTML = "";

    if (actions.length === 0) {
        results.innerHTML =
            "<p>No action items found. Try adding a task and deadline.</p>";
        return;
    }

    actions.forEach((action, index) => {

        const card = document.createElement("div");
        card.className = "result";

        const heading = document.createElement("h3");
        heading.textContent = "Action Item " + (index + 1);

        const owner = document.createElement("p");
        owner.textContent = "Owner: " + action.owner;

        const task = document.createElement("p");
        task.textContent = "Task: " + action.task;

        const deadline = document.createElement("p");
        deadline.textContent = "Deadline: " + action.deadline;

        card.appendChild(heading);
        card.appendChild(owner);
        card.appendChild(task);
        card.appendChild(deadline);

        results.appendChild(card);

    });
}

function copyResults() {

    if (actions.length === 0) {
        showMessage("No results to copy.", "red");
        return;
    }

    const text = JSON.stringify(actions, null, 2);

    const textarea = document.createElement("textarea");
    textarea.value = text;

    document.body.appendChild(textarea);
    textarea.select();

    document.execCommand("copy");

    textarea.remove();

    showMessage("Results copied!", "green");
}

function downloadResults() {

    if (actions.length === 0) {
        showMessage("No results to download.", "red");
        return;
    }

    const blob = new Blob(
        [JSON.stringify({actions: actions}, null, 2)],
        {type: "application/json"}
    );

    const url = URL.createObjectURL(blob);

    const link = document.createElement("a");
    link.href = url;
    link.download = "action_items.json";
    link.click();

    URL.revokeObjectURL(url);
}

function clearAll() {

    document.getElementById("notes").value = "";

    actions = [];

    displayResults();

    showMessage("", "");
}

function showMessage(text, color) {

    const message = document.getElementById("message");

    message.textContent = text;
    message.style.color = color;
}

</script>

</body>
</html>
"""

display(HTML(html_code))
